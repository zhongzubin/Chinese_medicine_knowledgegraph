# 大模型接口
MODEL_API_KEY=your_model_api_key
MODEL_BASE_URL=https://your-model-endpoint/v1
MODEL_NAME=your_model_name

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# 知识图谱问答 API
GRAPH_QA_AUTH_REQUIRED=true
GRAPH_QA_API_KEYS_JSON={"local-client":"replace_with_a_random_key_at_least_32_chars"}
GRAPH_QA_REDIS_URL=redis://127.0.0.1:6379/0
GRAPH_QA_REDIS_PREFIX=graph_qa
GRAPH_QA_RATE_LIMIT_REQUESTS=10
GRAPH_QA_RATE_LIMIT_WINDOW_SECONDS=60
GRAPH_QA_MAX_CONCURRENT_REQUESTS=4
GRAPH_QA_CONCURRENCY_LEASE_SECONDS=60
GRAPH_QA_MAX_RESULTS=50
GRAPH_QA_SESSION_TTL_SECONDS=86400
GRAPH_QA_SESSION_MAX_TURNS=5
GRAPH_QA_SESSION_LOCK_SECONDS=180
GRAPH_QA_DYNAMIC_MULTI_HOP_ENABLED=true
GRAPH_QA_DEMO_COOKIE_SECURE=false
GRAPH_QA_TRUST_PROXY_HEADERS=false

# 混合实体检索
GRAPH_QA_VECTOR_ENABLED=true
GRAPH_QA_EMBEDDING_MODEL=models/bge-large-zh-v1.5
GRAPH_QA_VECTOR_TOP_K=3
GRAPH_QA_VECTOR_THRESHOLD=0.56

# Streamlit 客户端
GRAPH_QA_STREAMLIT_API_URL=http://127.0.0.1:8000
GRAPH_QA_STREAMLIT_API_KEY=replace_with_a_random_key_at_least_32_chars
